library IEEE;

use IEEE.STD_LOGIC_1164.ALL;



entity PRNG is

    Generic (SEED : std_logic_vector(7 downto 0) := "10101010");

    Port ( clk : in STD_LOGIC; random_out : out std_logic_vector(1 downto 0);

           rand_x : out std_logic_vector(5 downto 0); rand_y : out std_logic_vector(5 downto 0) );

end PRNG;



architecture Behavioral of PRNG is

    signal lfsr : std_logic_vector(7 downto 0) := SEED;

begin

    process(clk) begin

        if rising_edge(clk) then

            lfsr <= lfsr(6 downto 0) & (lfsr(7) xor lfsr(5) xor lfsr(4) xor lfsr(3));

        end if;

    end process;

    random_out <= lfsr(1 downto 0);

    rand_x <= lfsr(5 downto 0);

    rand_y <= lfsr(7 downto 2);

end Behavioral;

